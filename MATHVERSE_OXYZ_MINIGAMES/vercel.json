{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,stages.js,server.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__api=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js?__path=$1"
    }
  ]
}

